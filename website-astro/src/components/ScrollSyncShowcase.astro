---
// ScrollSyncShowcase.astro
// A two-column scroll-sync section with a sticky index on the left.
//
// The four beats tell one story in order: point it at existing data, let an
// agent finish the setup over MCP, hand a real UI to the team, extend it in
// React. Each beat's media has to show the thing its copy claims — the previous
// version had the index and the screens off by one against each other.
import McpSessionDemo from "./McpSessionDemo.tsx";
import CustomFieldDemo from "./CustomFieldDemo.tsx";
import ProductsCollectionDemo from "./ProductsCollectionDemo.tsx";
import { SchemaEditorDemo } from "./SchemaEditorDemo.tsx";
import { useTranslations } from "../i18n/utils";

const { lang } = Astro.props;
const t = useTranslations(lang ?? "en");

const beats = [
    { id: "screen-1", titleKey: "showcase.item1.title", descKey: "showcase.item1.desc" },
    { id: "screen-2", titleKey: "showcase.item2.title", descKey: "showcase.item2.desc" },
    { id: "screen-3", titleKey: "showcase.item3.title", descKey: "showcase.item3.desc" },
    { id: "screen-4", titleKey: "showcase.item4.title", descKey: "showcase.item4.desc" }
] as const;
---

<section id="scroll-sync-showcase" class="relative isolate bg-black py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <!-- Section title, aligned with the sticky index below it -->
        <div class="w-full lg:w-[400px] mb-36 mt-16">
            <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">{t('showcase.section.title')}</h2>
            <p class="mt-6 text-lg leading-8 text-surface-400">{t('showcase.section.subtitle')}</p>
        </div>

        <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">
            <!-- Left: sticky index — hidden on mobile, where each beat carries its own heading -->
            <aside class="hidden lg:block lg:w-[400px] flex-shrink-0">
                <nav class="sticky top-48">
                    <ol class="space-y-8">
                        {beats.map((beat, i) => (
                            <li>
                                <a href={`#${beat.id}`} data-index-item class="group block" data-active="false">
                                    <div class="flex items-baseline gap-3">
                                        <span class="font-mono text-sm tabular-nums text-surface-600 transition-colors group-data-[active=true]:text-primary">
                                            {String(i + 1).padStart(2, "0")}
                                        </span>
                                        <span class="text-2xl font-medium tracking-tight text-white sm:text-3xl transition-opacity group-data-[active=false]:opacity-40 group-data-[active=true]:opacity-100">
                                            {t(beat.titleKey)}
                                        </span>
                                    </div>
                                    <div class="overflow-hidden transition-all duration-300 ease-out group-data-[active=false]:max-h-0 group-data-[active=true]:max-h-72">
                                        <p class="text-base leading-7 text-surface-400 pt-2 pb-1 pl-9 opacity-0 group-data-[active=true]:opacity-100 transition-opacity duration-300 delay-75"
                                           set:html={t(beat.descKey)}></p>
                                    </div>
                                </a>
                            </li>
                        ))}
                    </ol>
                </nav>
            </aside>

            <!-- Right: the evidence for each beat -->
            <div class="flex-1 w-full lg:min-w-0">
                <div class="w-full lg:w-[1240px] space-y-32">

                    <!-- 1 — Point it at your data: the schema editor inferring from live documents -->
                    <div id="screen-1" class="scroll-mt-32">
                        <h3 class="lg:hidden text-2xl font-medium tracking-tight text-white mb-3">{t('showcase.item1.title')}</h3>
                        <p class="lg:hidden text-base leading-7 text-surface-400 mb-6" set:html={t('showcase.item1.desc')}></p>
                        <section data-screen class="w-full will-change-transform">
                            <div class="relative h-[560px] overflow-hidden rounded-2xl ring-1 ring-white/10 bg-surface-950">
                                <SchemaEditorDemo client:visible />
                            </div>
                            <p class="mt-3 text-sm text-surface-500">Property types inferred from the documents already in the collection, then refined.</p>
                        </section>
                    </div>

                    <!-- 2 — Or let an agent set it up: the MCP session -->
                    <div id="screen-2" class="scroll-mt-32">
                        <h3 class="lg:hidden text-2xl font-medium tracking-tight text-white mb-3">{t('showcase.item2.title')}</h3>
                        <p class="lg:hidden text-base leading-7 text-surface-400 mb-6" set:html={t('showcase.item2.desc')}></p>
                        <section data-screen class="w-full will-change-transform">
                            <McpSessionDemo client:visible />
                            <!-- Kept inside the left ~750px: everything past that is
                                 clipped by the bleed, and this is the one beat with a
                                 call to action. -->
                            <div class="mt-5 max-w-xl">
                                <p class="text-sm leading-6 text-surface-400">
                                    Add the server to any MCP client and sign in with the account you already use.
                                </p>
                                <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-3">
                                    <code class="rounded-lg bg-surface-900/70 px-3 py-2 font-mono text-[12.5px] text-surface-300 ring-1 ring-inset ring-surface-800">{t('showcase.mcp.install')}</code>
                                    <a href="https://www.npmjs.com/package/@firecms/mcp-server"
                                       target="_blank" rel="noopener noreferrer"
                                       class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary underline-offset-4 hover:underline">
                                        {t('showcase.mcp.cta')}
                                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                    </a>
                                </div>
                            </div>
                        </section>
                    </div>

                    <!-- 3 — Your team edits in a real UI: inline editing in the collection table -->
                    <div id="screen-3" class="scroll-mt-32">
                        <h3 class="lg:hidden text-2xl font-medium tracking-tight text-white mb-3">{t('showcase.item3.title')}</h3>
                        <p class="lg:hidden text-base leading-7 text-surface-400 mb-6" set:html={t('showcase.item3.desc')}></p>
                        <section data-screen class="w-full will-change-transform">
                            <ProductsCollectionDemo client:visible />
                            <p class="mt-3 text-sm text-surface-500">Typed fields — images, enums, switches, ratings — edited inline in the table.</p>
                        </section>
                    </div>

                    <!-- 4 — You extend it in React: a fully custom field -->
                    <div id="screen-4" class="scroll-mt-32">
                        <h3 class="lg:hidden text-2xl font-medium tracking-tight text-white mb-3">{t('showcase.item4.title')}</h3>
                        <p class="lg:hidden text-base leading-7 text-surface-400 mb-6" set:html={t('showcase.item4.desc')}></p>
                        <section data-screen class="w-full will-change-transform">
                            <CustomFieldDemo client:visible />
                            <p class="mt-3 text-sm text-surface-500">The body-part picker is the real field MedicalMotion's therapists use.</p>
                        </section>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script>

        const root = document.getElementById("scroll-sync-showcase");
        const wrappers = (root?.querySelectorAll("[id^='screen-']") as NodeListOf<HTMLElement>) || null;
        const screens = (root?.querySelectorAll("[data-screen]") as NodeListOf<HTMLElement>) || null;
        const indexItems = (root?.querySelectorAll("[data-index-item]") as NodeListOf<HTMLAnchorElement>) || null;

        if (wrappers && screens && indexItems) {
            const byId = new Map<string, HTMLAnchorElement>();
            indexItems.forEach((a) => {
                const id = a.getAttribute("href")?.replace("#", "") || "";
                if (id) byId.set(id, a);
                a.addEventListener("click", (e) => {
                    e.preventDefault();
                    const target = document.getElementById(id);
                    if (target) {
                        // Use scrollTo for vertical-only scrolling to prevent horizontal shift
                        const targetRect = target.getBoundingClientRect();
                        const scrollMargin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
                        const targetY = window.scrollY + targetRect.top - scrollMargin;
                        window.scrollTo({
                            top: targetY,
                            behavior: "smooth"
                        });
                    }
                });
            });

            let currentActive = "";

            const activate = (id: string) => {
                if (currentActive === id) return; // Prevent unnecessary updates
                currentActive = id;
                indexItems.forEach((a) => a.setAttribute("data-active", "false"));
                const el = byId.get(id);
                if (el) el.setAttribute("data-active", "true");
            };

            // Track all intersecting sections
            const intersectionState = new Map<string, IntersectionObserverEntry>();

            let updateTimeout: number | null = null;

            const updateActiveSection = () => {
                // Find the section with highest intersection ratio
                let bestEntry: IntersectionObserverEntry | null = null;
                let bestRatio = 0;

                intersectionState.forEach((entry) => {
                    if (entry.isIntersecting && entry.intersectionRatio > bestRatio) {
                        bestRatio = entry.intersectionRatio;
                        bestEntry = entry;
                    }
                });

                if (bestEntry) {
                    const target = (bestEntry as IntersectionObserverEntry).target;
                    if (target instanceof HTMLElement) {
                        activate(target.id);
                    }
                }
            };

            // Keep IO for index activation only
            const io = new IntersectionObserver(
                (entries) => {
                    // Update the state for each entry
                    entries.forEach((entry) => {
                        intersectionState.set(entry.target.id, entry);
                    });

                    // Debounce the activation to prevent flashing
                    if (updateTimeout) clearTimeout(updateTimeout);
                    updateTimeout = window.setTimeout(updateActiveSection, 50);
                },
                {
                    rootMargin: "-20% 0px -30% 0px",
                    threshold: [0.1, 0.5]
                }
            );
            wrappers.forEach((w) => io.observe(w));

            // Scroll-bound animation
            const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            const maxOffsetPx = 32; // slide distance
            const minOpacity = 0.25; // ensure minimum opacity is not 0 for subtlety

            const clamp = (v: number, min: number, max: number): number => Math.max(min, Math.min(max, v));

            const update = () => {
                const vh = window.innerHeight || 1;
                const start = vh * 0.2;
                const end = vh * 0.6;
                const span = Math.max(1, end - start);

                if (prefersReduced) {
                    screens.forEach((s) => {
                        s.style.opacity = "1";
                        s.style.transform = "translate3d(0,0,0)";
                    });
                    return;
                }

                // Phase 1: Read UI state first to avoid layout thrashing
                const tops = Array.from(screens).map((s) => s.getBoundingClientRect().top);

                // Phase 2: Write UI state
                screens.forEach((s, i) => {
                    const top = tops[i];
                    // progress 0..1 based on section top moving from start to end
                    const p = clamp((end - top) / span, 0, 1);
                    const tx = (1 - p) * maxOffsetPx;
                    const op = minOpacity + p * (1 - minOpacity);
                    s.style.opacity = String(op);
                    s.style.transform = `translate3d(${tx}px, 0, 0)`;
                });
            };

            let ticking = false;
            const requestTick = () => {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(() => {
                    update();
                    ticking = false;
                });
            };

            window.addEventListener("scroll", requestTick, { passive: true });
            window.addEventListener("resize", requestTick);
            // Initial paint
            requestTick();
        }
    </script>
</section>
