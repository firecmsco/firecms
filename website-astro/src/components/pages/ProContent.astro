---
import ImportMappingDemo from "../ImportMappingDemo.tsx";
import { SchemaEditorDemo } from "../SchemaEditorDemo.tsx";
import RolePermissionsDemo from "../RolePermissionsDemo.tsx";
import EntityHistoryDemo from "../EntityHistoryDemo.tsx";
import Icon from "../Icon.astro";
// src/components/pages/ProContent.astro
import SectionBackgroundAccents from "../SectionBackgroundAccents.astro";
import CurrencyToggle from "../CurrencyToggle.astro";
import PriceText from "../PriceText.astro";
import { useTranslatedPath } from "../../i18n/utils";
import { PRO_PRICES } from "../../utils/pro_pricing";

const { lang, t } = Astro.props;
const tp = useTranslatedPath(lang as any);

// Trial and purchase both start here; the app opens the PRO license flow.
const PRO_SUBSCRIBE_URL = "https://app.firecms.co/subscriptions?intent=pro";

// The only escaping the snippet below needs: translations are plain text.
const escapeHtml = (value: string) => value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const [dataBeforeLink, dataAfterLink = ""] = t('pro.data.desc').split("{link}");
---

<main class="flex-grow bg-black text-white overflow-hidden">
    <!-- Hero Section -->
    <section class="relative isolate overflow-hidden bg-linear-to-br from-black to-surface-950 pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24 animate-on-scroll fade-in">
        <!-- Background accents and subtle grid -->
        <SectionBackgroundAccents topLine={true} blob={{ position: "top", size: "lg", opacity: 60 }}/>
        <div class="pointer-events-none absolute inset-0 -z-10">
            <div class="absolute -bottom-40 right-1/3 w-[700px] h-[700px] rounded-full bg-blue-500/5 blur-3xl opacity-50"></div>
            <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:40px_40px] opacity-10"></div>
        </div>

        <div class="px-4 mx-auto max-w-7xl text-center lg:px-12">
            <div class="inline-flex items-center py-1.5 px-3 mb-6 sm:mb-7 text-sm rounded-full bg-yellow-400/10 text-yellow-400 ring-1 ring-inset ring-yellow-400/20 mx-auto animate-on-scroll fade-in-up" role="status">
                <span class="text-sm font-medium">{t('pro.hero.badge')}</span>
            </div>
            <h1 class="mb-6 text-4xl font-medium tracking-tight md:text-5xl lg:text-6xl text-white font-sans animate-on-scroll fade-in-up delay-100">
                {t('pro.hero.title')}
            </h1>
            <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl sm:px-16 xl:px-48 max-w-4xl mx-auto animate-on-scroll fade-in-up delay-200">
                {t('pro.hero.subtitle')}
            </p>
            <!-- Price -->
            <div class="mb-10 flex flex-col items-center gap-4 animate-on-scroll fade-in-up delay-200">
                <CurrencyToggle/>
                <p class="text-xl font-semibold text-white sm:text-2xl">
                    <PriceText text={t('pro.price.line')} prices={PRO_PRICES} ids={{ first: "pro-price", additional: "pro-price-additional" }}
                               priceClass="text-yellow-400"/>
                </p>
                <ul class="flex flex-col sm:flex-row items-center justify-center gap-x-6 gap-y-2 text-sm text-surface-300">
                    <li class="flex items-center gap-2">
                        <svg class="h-4 w-4 flex-none text-yellow-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        {t('pro.price.seats')}
                    </li>
                    <li class="flex items-center gap-2">
                        <svg class="h-4 w-4 flex-none text-yellow-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        {t('pro.price.trial')}
                    </li>
                </ul>
            </div>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-on-scroll fade-in-up delay-300">
                <a href={PRO_SUBSCRIBE_URL} target="_blank" rel="noopener noreferrer"
                   data-track
                   id="pro-start-trial"
                   class="w-full sm:w-auto inline-flex items-center justify-center gap-x-2 rounded-md bg-yellow-400 px-6 py-3 text-base font-semibold text-black shadow-sm hover:bg-yellow-300 transition-all duration-200 ease-in-out btn-glow">
                    {t('pro.hero.cta.trial')}
                    <svg class="h-5 w-5 text-black" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                    </svg>
                </a>
                <a href={tp("/docs/pro/licensing")}
                   class="w-full sm:w-auto inline-flex items-center justify-center gap-x-2 rounded-md border border-surface-700 bg-white/5 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-white/10 transition-all duration-200">
                    {t('pro.hero.cta.docs')}
                </a>
            </div>
        </div>
    </section>

    <!-- Visual Showcase / Key Features -->
    <section class="relative isolate bg-black py-16 sm:py-24">
        <SectionBackgroundAccents topLine={true}/>
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center mb-20 animate-on-scroll fade-in-up">
                <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">{t('pro.features.title')}</h2>
                <p class="mt-4 text-lg text-surface-400">{t('pro.features.subtitle')}</p>
            </div>

            <!-- Feature 1 -->
            <div class="py-16 border-b border-surface-800 animate-on-scroll fade-in-up">
                <div class="max-w-3xl space-y-5">
                    <div class="h-10 w-10 rounded-lg bg-yellow-400/10 flex items-center justify-center text-yellow-400">
                        <Icon name="table-properties" class="h-6 w-6"/>
                    </div>
                    <h3 class="text-2xl font-semibold text-white">{t('pro.features.schema.title')}</h3>
                    <p class="text-surface-400 leading-relaxed">
                        {t('pro.features.schema.desc')}
                    </p>
                </div>
                <!-- Full width: every one of these demos is a two-panel product view
                     that goes cramped below about 900px. -->
                <div class="mt-10 overflow-x-auto rounded-2xl">
                    <div class="min-w-[1000px]">
                        <div class="h-[780px] overflow-hidden rounded-2xl border border-surface-800 bg-surface-950">
                            <SchemaEditorDemo client:visible />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Feature 2 -->
            <div class="py-16 border-b border-surface-800 animate-on-scroll fade-in-up delay-100">
                <div class="max-w-3xl space-y-5">
                    <div class="h-10 w-10 rounded-lg bg-yellow-400/10 flex items-center justify-center text-yellow-400">
                        <Icon name="users" class="h-6 w-6"/>
                    </div>
                    <h3 class="text-2xl font-semibold text-white">{t('pro.features.users.title')}</h3>
                    <p class="text-surface-400 leading-relaxed">
                        {t('pro.features.users.desc')}
                    </p>
                </div>
                <!-- Full width: every one of these demos is a two-panel product view
                     that goes cramped below about 900px. -->
                <div class="mt-10 overflow-x-auto rounded-2xl">
                    <div class="min-w-[720px]">
                        <RolePermissionsDemo client:visible />
                    </div>
                </div>
            </div>

            <!-- Feature 3 -->
            <div class="py-16 border-b border-surface-800 animate-on-scroll fade-in-up">
                <div class="max-w-3xl space-y-5">
                    <div class="h-10 w-10 rounded-lg bg-yellow-400/10 flex items-center justify-center text-yellow-400">
                        <Icon name="arrow-down-up" class="h-6 w-6"/>
                    </div>
                    <h3 class="text-2xl font-semibold text-white">{t('pro.features.import.title')}</h3>
                    <p class="text-surface-400 leading-relaxed">
                        {t('pro.features.import.desc')}
                    </p>
                </div>
                <!-- Full width: every one of these demos is a two-panel product view
                     that goes cramped below about 900px. -->
                <div class="mt-10 overflow-x-auto rounded-2xl">
                    <div class="min-w-[760px]">
                        <ImportMappingDemo client:visible />
                    </div>
                </div>
            </div>

            <!-- Feature 4 -->
            <div class="py-16 animate-on-scroll fade-in-up delay-100">
                <div class="max-w-3xl space-y-5">
                    <div class="h-10 w-10 rounded-lg bg-yellow-400/10 flex items-center justify-center text-yellow-400">
                        <Icon name="history" class="h-6 w-6"/>
                    </div>
                    <h3 class="text-2xl font-semibold text-white">{t('pro.features.history.title')}</h3>
                    <p class="text-surface-400 leading-relaxed">
                        {t('pro.features.history.desc')}
                    </p>
                </div>
                <!-- Full width: every one of these demos is a two-panel product view
                     that goes cramped below about 900px. -->
                <div class="mt-10 overflow-x-auto rounded-2xl">
                    <div class="min-w-[680px]">
                        <EntityHistoryDemo client:visible />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Next.js Integration Section -->
    <section class="relative isolate bg-black py-16 sm:py-24">
        <SectionBackgroundAccents topLine={true}/>
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center animate-on-scroll fade-in-up">
                <div class="space-y-6">
                    <div class="h-10 w-10 rounded-lg bg-yellow-400/10 flex items-center justify-center text-yellow-400">
                        <Icon name="code" class="h-6 w-6"/>
                    </div>
                    <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">{t('pro.nextjs.title')}</h2>
                    <p class="text-surface-400 leading-relaxed">
                        {t('pro.nextjs.desc')}
                    </p>
                    <ul class="space-y-3 text-surface-300">
                        {[t('pro.nextjs.f1'), t('pro.nextjs.f2'), t('pro.nextjs.f3')].map((item) => (
                            <li class="flex items-center gap-3">
                                <svg class="h-5 w-5 flex-none text-yellow-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                                {item}
                            </li>
                        ))}
                    </ul>
                </div>
                <div class="relative bg-surface-900/40 rounded-2xl border border-surface-800 p-6 font-mono text-sm shadow-xl">
                    <div class="flex items-center justify-between border-b border-surface-800 pb-3 mb-4">
                        <span class="text-xs text-surface-500 font-medium">app/cms/App.tsx</span>
                        <div class="flex gap-1.5">
                            <div class="w-3 h-3 rounded-full bg-red-500/30"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500/30"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500/30"></div>
                        </div>
                    </div>
                    <pre class="overflow-x-auto text-surface-200" set:html={`<code><span class="text-blue-400">"use client"</span>;

<span class="text-purple-400">import</span> { FireCMS, Scaffold } <span class="text-purple-400">from</span> <span class="text-green-300">"@firecms/core"</span>;
<span class="text-purple-400">import</span> { useCollectionEditorPlugin } <span class="text-purple-400">from</span> <span class="text-green-300">"@firecms/collection_editor"</span>;

<span class="text-purple-400">export function</span> <span class="text-blue-300">CMS</span>() {
    <span class="text-purple-400">const</span> collectionEditor = <span class="text-blue-300">useCollectionEditorPlugin</span>({ collectionConfigController });

    <span class="text-purple-400">return</span> &lt;<span class="text-blue-300">FireCMS</span>
        <span class="text-surface-500">// ${escapeHtml(t('pro.nextjs.code.comment'))}</span>
        apiKey={process.env.NEXT_PUBLIC_FIRECMS_API_KEY}
        plugins={[collectionEditor]}
        navigationController={navigationController}
        authController={authController}
        dataSourceDelegate={firestoreDelegate}&gt;
        {() =&gt; &lt;<span class="text-blue-300">Scaffold</span>&gt;…&lt;/<span class="text-blue-300">Scaffold</span>&gt;}
    &lt;/<span class="text-blue-300">FireCMS</span>&gt;;
}</code>`} />
                </div>
            </div>
        </div>
    </section>

    <!-- Absolute Sovereignty / Security Section -->
    <section class="relative isolate bg-black py-16 sm:py-24">
        <SectionBackgroundAccents topLine={true}/>
        <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center animate-on-scroll fade-in-up">
            <div class="mx-auto max-w-3xl">
                <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-6">{t('pro.data.title')}</h2>
                <p class="text-lg text-surface-400 leading-relaxed mb-4">
                    {dataBeforeLink}<a href={tp("/docs/self/telemetry")} class="text-white underline underline-offset-4 hover:text-yellow-400 transition-colors">{t('pro.data.link')}</a>{dataAfterLink}
                </p>
                <p class="text-base text-surface-500 leading-relaxed mb-8">
                    {t('pro.data.ai')}
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center mt-12">
                    <div class="bg-surface-900/30 rounded-xl border border-surface-800 p-6">
                        <div class="text-3xl font-extrabold text-yellow-400 mb-2">0</div>
                        <div class="text-sm font-medium text-white">{t('pro.data.stat.credentials')}</div>
                    </div>
                    <div class="bg-surface-900/30 rounded-xl border border-surface-800 p-6">
                        <div class="text-3xl font-extrabold text-yellow-400 mb-2">0</div>
                        <div class="text-sm font-medium text-white">{t('pro.data.stat.content')}</div>
                    </div>
                    <div class="bg-surface-900/30 rounded-xl border border-surface-800 p-6">
                        <div class="text-3xl font-extrabold text-yellow-400 mb-2">{t('pro.data.stat.direct.value')}</div>
                        <div class="text-sm font-medium text-white">{t('pro.data.stat.direct.label')}</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Final CTA Section -->
    <section class="relative isolate bg-black py-16 sm:py-24">
        <SectionBackgroundAccents topLine={true}/>
        <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
            <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-8 animate-on-scroll fade-in-up">
                {t('pro.cta.title')}
            </h2>
            <p class="text-lg text-surface-400 max-w-2xl mx-auto mb-10 animate-on-scroll fade-in-up delay-100">
                {t('pro.cta.desc')}
            </p>
            <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4 animate-on-scroll fade-in-up delay-200">
                <a href={PRO_SUBSCRIBE_URL} target="_blank" rel="noopener noreferrer"
                   data-track
                   id="pro-buy"
                   class="inline-flex items-center gap-x-2 rounded-md bg-yellow-400 px-6 py-3 text-base font-semibold text-black shadow-sm hover:bg-yellow-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400 transition-all duration-200 ease-in-out btn-glow">
                    {t('pro.cta.buy')}
                    <Icon name="arrow-right" class="h-5 w-5 text-black"/>
                </a>
                <a href={tp("/pricing")}
                   class="inline-flex items-center gap-x-2 text-white hover:text-primary transition-colors font-semibold">
                    {t('pro.cta.compare')}
                    <Icon name="arrow-right" class="text-white h-4 w-4"/>
                </a>
            </div>
        </div>
    </section>
</main>
