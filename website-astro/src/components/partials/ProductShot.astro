---
// ProductShot.astro
// Frames a real product screenshot or clip in browser chrome, with an optional
// caption that says what the reader is looking at. Used by the keyword landing
// pages so every claim sits next to its evidence.
interface Props {
    src: string;
    alt: string;
    caption?: string;
    /** Intrinsic pixel size of the asset — reserved so the page never reflows on load. */
    width: number;
    height: number;
    video?: boolean;
    poster?: string;
    class?: string;
    loading?: "lazy" | "eager";
}

const {
    src,
    alt,
    caption,
    width,
    height,
    video = false,
    poster,
    class: className,
    loading = "lazy"
} = Astro.props;
---

<figure class:list={["group m-0", className]}>
    <div
        class="relative overflow-hidden rounded-xl border border-surface-800 bg-surface-900/60 shadow-[0_24px_60px_-30px_rgba(0,0,0,0.9)]">
        <!-- Window chrome: signals "this is the running product", not an illustration -->
        <div class="flex items-center gap-1.5 border-b border-surface-800/80 bg-surface-900 px-3.5 h-9">
            <span class="h-2.5 w-2.5 rounded-full bg-surface-700"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-surface-700"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-surface-700"></span>
        </div>
        {video ? (
            <video
                class="block w-full h-auto"
                width={width}
                height={height}
                src={src}
                poster={poster}
                autoplay
                loop
                muted
                playsinline
                aria-label={alt}
            />
        ) : (
            <img
                class="block w-full h-auto"
                src={src}
                alt={alt}
                width={width}
                height={height}
                loading={loading}
                decoding="async"
            />
        )}
    </div>
    {caption && (
        <figcaption class="mt-3 text-sm leading-6 text-surface-500">{caption}</figcaption>
    )}
</figure>
