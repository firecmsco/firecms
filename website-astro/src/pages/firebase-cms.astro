---
// src/pages/firebase-cms.astro
// Dedicated landing page for the "Firebase CMS" keyword cluster.
// English only — see `localized={false}` on the Layout below.
import Layout from "../layouts/Layout.astro";
import SectionBackgroundAccents from "../components/SectionBackgroundAccents.astro";

const title = "Firebase CMS — The Open-Source CMS for Firebase & Firestore | FireCMS";
const description = "FireCMS is an open-source Firebase CMS: a real content management system on top of Firestore, Firebase Auth and Storage. Auto-generate collections from existing data, run it in the cloud or self-host it.";
const keywords = "Firebase CMS, CMS for Firebase, headless CMS for Firebase, Firebase headless CMS, open source Firebase CMS, Firebase content management system, Firebase admin panel, Firestore CMS, Firebase back office";

const breadcrumbs = [
    { name: "Home", url: "https://firecms.co" },
    { name: "Firebase CMS", url: "https://firecms.co/firebase-cms" }
];

// These mirror the questions that actually show up in Search Console for this cluster.
const faqItems = [
    {
        question: "What is a Firebase CMS?",
        answer: "A Firebase CMS is a content management system that reads and writes directly to your own Firebase project — Firestore documents, Firebase Storage files and Firebase Auth users — instead of storing content in a third-party database. It gives editors a structured, permissioned interface over data your application already owns, so there is no migration and no second source of truth."
    },
    {
        question: "Is there an open-source Firebase CMS?",
        answer: "Yes. FireCMS is open source under the MIT licence. You can self-host the framework in your own infrastructure with full source access, or use the managed FireCMS Cloud if you would rather not run it yourself."
    },
    {
        question: "Can a Firebase CMS generate itself from my existing Firestore collections?",
        answer: "FireCMS infers a schema from the documents already in your Firestore collections and generates the CRUD views, forms and validation from it. You can then refine field types, labels and validation in the visual schema editor or in TypeScript."
    },
    {
        question: "Firebase CMS vs building a custom admin panel — which should I choose?",
        answer: "A custom admin panel costs weeks of build time and then never stops needing maintenance as your data model changes. A Firebase CMS gives you the CRUD layer, field types, validation, permissions and file handling on day one, and stays extensible: in FireCMS you can drop in your own React components or entire custom views wherever the defaults are not enough."
    },
    {
        question: "Does FireCMS support custom field components?",
        answer: "Yes. Any React component can be used as a form field, and you can add entirely new top-level views to the navigation. Custom views are supported both in the self-hosted framework and in FireCMS Cloud."
    },
    {
        question: "How does user management work in a Firebase CMS?",
        answer: "FireCMS builds on Firebase Authentication. You define roles and per-collection permissions (create, edit, delete) and can resolve permissions dynamically per user or per document, so editors, marketers and admins each see only what they should."
    },
    {
        question: "Does FireCMS store or access my data?",
        answer: "No. Your content stays in your own Firebase project. FireCMS runs against your Firestore instance using your own security rules and credentials, which is why there is no vendor lock-in and no data migration when you adopt or leave it."
    }
];
---

<Layout
        title={title}
        description={description}
        keywords={keywords}
        breadcrumbs={breadcrumbs}
        faqItems={faqItems}
        localized={false}
>
    <main>
        <!-- Hero -->
        <section class="relative isolate overflow-hidden bg-linear-to-br from-black to-surface-950 pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24">
            <SectionBackgroundAccents topLine={true} blob={{ position: "top", size: "lg", opacity: 60 }}/>
            <div class="pointer-events-none absolute inset-0 -z-10">
                <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:40px_40px] opacity-10"></div>
            </div>

            <div class="px-4 mx-auto max-w-7xl text-center lg:px-12">
                <div class="inline-flex items-center py-1.5 px-3 mb-6 sm:mb-7 text-sm rounded-full bg-surface-800/40 text-surface-400 ring-1 ring-inset ring-white/10 mx-auto" role="status">
                    <span class="text-sm font-medium">Open source · MIT licensed · Your data stays yours</span>
                </div>
                <h1 class="mb-8 text-5xl font-extrabold tracking-tight leading-none md:text-6xl text-white font-sans">
                    The Open-Source <span class="text-orange-500 subtle-shimmer">Firebase</span> CMS
                </h1>
                <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl sm:px-16 xl:px-48">
                    FireCMS turns your existing Firebase project into a real content management system.
                    It reads and writes your own Firestore data, your own Storage files and your own Auth
                    users — no migration, no copies, no lock-in.
                </p>
                <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
                    <a href="https://app.firecms.co"
                       data-track
                       id="firebase-cms-start"
                       class="inline-flex items-center gap-x-2 rounded-md bg-primary px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-dark transition-all duration-200 ease-in-out btn-glow">
                        Start for Free
                    </a>
                    <a href="/developers"
                       class="inline-flex items-center gap-x-2 rounded-md border border-surface-700 bg-surface-900/50 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-surface-800 transition-all duration-200 ease-in-out">
                        Self-Host It
                    </a>
                </div>
            </div>
        </section>

        <!-- Definition: the snippet-friendly answer -->
        <section class="bg-black py-16 sm:py-24">
            <div class="mx-auto max-w-3xl px-6 lg:px-8">
                <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-6">What is a Firebase CMS?</h2>
                <p class="text-lg leading-8 text-surface-300 mb-5">
                    A <strong class="text-white">Firebase CMS</strong> is a content management system that
                    stores its content in <em>your</em> Firebase project rather than in a vendor's database.
                    Editors get structured forms, validation and permissions; your application keeps reading
                    the same Firestore collections it always did.
                </p>
                <p class="text-lg leading-8 text-surface-400">
                    That is the difference between a Firebase CMS and a conventional headless CMS. A headless
                    CMS such as Contentful or Strapi owns the content and hands it back over an API, which
                    means a second database, a sync problem and a migration. A Firebase CMS sits on top of the
                    database you already have.
                </p>
            </div>
        </section>

        <!-- Console comparison -->
        <section class="bg-black py-16 sm:py-24">
            <div class="mx-auto max-w-5xl px-6 lg:px-8">
                <div class="mx-auto max-w-2xl text-center mb-14">
                    <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Why the Firebase Console is not a CMS</h2>
                    <p class="mt-4 text-lg leading-8 text-surface-400">
                        The console is an excellent operations tool for developers. It was never meant to be
                        handed to the people who write your content.
                    </p>
                </div>
                <div class="overflow-x-auto rounded-2xl ring-1 ring-inset ring-surface-800">
                    <table class="w-full text-left text-surface-300">
                        <thead class="bg-surface-900/70 text-white">
                            <tr>
                                <th scope="col" class="px-6 py-4 font-semibold">&nbsp;</th>
                                <th scope="col" class="px-6 py-4 font-semibold">Firebase Console</th>
                                <th scope="col" class="px-6 py-4 font-semibold">FireCMS</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-surface-800">
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white">Data entry</th><td class="px-6 py-4">Raw JSON-ish field editor</td><td class="px-6 py-4">Typed forms, 20+ field types, validation</td></tr>
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white">Rich text</th><td class="px-6 py-4">Plain strings</td><td class="px-6 py-4">Notion-style editor, markdown</td></tr>
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white">Files</th><td class="px-6 py-4">Separate Storage tab, manual URLs</td><td class="px-6 py-4">Upload fields wired to Firebase Storage</td></tr>
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white">References</th><td class="px-6 py-4">Copy and paste document paths</td><td class="px-6 py-4">Searchable reference pickers</td></tr>
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white">Non-technical access</th><td class="px-6 py-4">Full project access or nothing</td><td class="px-6 py-4">Per-collection roles and permissions</td></tr>
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white">Custom logic</th><td class="px-6 py-4">None</td><td class="px-6 py-4"><code>onSave</code> / <code>onDelete</code> callbacks, custom React views</td></tr>
                        </tbody>
                    </table>
                </div>
                <p class="mt-8 text-center text-surface-400">
                    A deeper breakdown lives in
                    <a href="/compare/firecms-vs-firebase-console" class="text-primary hover:underline">FireCMS vs the Firebase Console</a>.
                </p>
            </div>
        </section>

        <!-- What you get across the Firebase stack -->
        <section class="bg-black py-16 sm:py-24">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
                <div class="mx-auto max-w-2xl text-center mb-14">
                    <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">A CMS across the whole Firebase stack</h2>
                    <p class="mt-4 text-lg leading-8 text-surface-400">Not just Firestore documents.</p>
                </div>
                <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
                    <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-2">Cloud Firestore</h3>
                        <p class="text-surface-400">Collections, subcollections, references, arrays and maps — generated from the documents you already have. See the <a href="/firestore-cms" class="text-primary hover:underline">Firestore CMS</a> details.</p>
                    </div>
                    <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-2">Firebase Storage</h3>
                        <p class="text-surface-400">Image and file fields that upload straight to your Storage bucket, with previews and generated paths.</p>
                    </div>
                    <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-2">Firebase Auth</h3>
                        <p class="text-surface-400">Sign-in for your editors, plus roles and per-collection permissions resolved per user or per document.</p>
                    </div>
                    <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-2">Cloud Functions</h3>
                        <p class="text-surface-400">Trigger your own business logic from the CMS with <code>onSave</code> and <code>onDelete</code> callbacks.</p>
                    </div>
                    <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-2">Security rules</h3>
                        <p class="text-surface-400">FireCMS talks to Firestore as your signed-in user, so the rules you already wrote keep applying.</p>
                    </div>
                    <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-2">React, all the way down</h3>
                        <p class="text-surface-400">Custom fields, custom views and your own components — see the <a href="/developers" class="text-primary hover:underline">developer docs</a>.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Cloud vs self-hosted -->
        <section class="bg-black py-16 sm:py-24">
            <div class="mx-auto max-w-5xl px-6 lg:px-8">
                <div class="mx-auto max-w-2xl text-center mb-14">
                    <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Hosted, or hosted by you</h2>
                </div>
                <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
                    <div class="rounded-2xl bg-surface-900/50 p-8 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-3">FireCMS Cloud</h3>
                        <p class="text-surface-400 mb-4">Connect your Firebase project and get a working CMS in minutes. Automatic updates, custom React views still supported, free trial.</p>
                        <a href="https://app.firecms.co" data-track id="firebase-cms-cloud" class="text-primary hover:underline font-semibold">Start building →</a>
                    </div>
                    <div class="rounded-2xl bg-surface-900/50 p-8 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-3">Self-hosted</h3>
                        <p class="text-surface-400 mb-4">MIT-licensed source, deployed in your own infrastructure, with custom auth, SSO and whatever compliance story you need.</p>
                        <a href="/pro" class="text-primary hover:underline font-semibold">See self-hosted options →</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="bg-black py-16 sm:py-24">
            <div class="mx-auto max-w-3xl px-6 lg:px-8">
                <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-12 text-center">Firebase CMS FAQ</h2>
                <dl class="space-y-8">
                    {faqItems.map(item => (
                        <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                            <dt class="text-xl font-semibold text-white mb-3">{item.question}</dt>
                            <dd class="text-surface-400 leading-7">{item.answer}</dd>
                        </div>
                    ))}
                </dl>
            </div>
        </section>

        <!-- Related -->
        <section class="bg-black pb-24">
            <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
                <h2 class="text-2xl font-medium tracking-tight text-white mb-6">Keep reading</h2>
                <ul class="flex flex-wrap justify-center gap-x-6 gap-y-3 text-surface-300">
                    <li><a href="/firestore-cms" class="text-primary hover:underline">Firestore CMS</a></li>
                    <li><a href="/compare/firecms-vs-firebase-console" class="text-primary hover:underline">vs Firebase Console</a></li>
                    <li><a href="/compare/firecms-vs-strapi" class="text-primary hover:underline">vs Strapi</a></li>
                    <li><a href="/compare/firecms-vs-contentful" class="text-primary hover:underline">vs Contentful</a></li>
                    <li><a href="/blog/unlocking_power_firebase_cms" class="text-primary hover:underline">Unlocking the power of a Firebase CMS</a></li>
                    <li><a href="/pricing" class="text-primary hover:underline">Pricing</a></li>
                </ul>
            </div>
        </section>
    </main>
</Layout>
