---
import Layout from "../../layouts/Layout.astro";
// The policy body is generated by our policy tool and is not well formed enough for the
// Astro compiler to parse as JSX (unbalanced inline tags). It is kept verbatim in a plain
// .html file and injected as raw HTML instead.
import termsContent from "./terms_conditions_content.html?raw";

const title = "FireCMS Terms of Service";
const description = "Terms and conditions for using FireCMS services.";

const breadcrumbs = [
    { name: "Home", url: "https://firecms.co" },
    { name: "Terms and Conditions", url: "https://firecms.co/policy/terms_conditions" }
];
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
    <div class="mx-auto max-w-7xl p-8">
        <div class="policy-content" set:html={termsContent}/>
        <style is:global>
            .policy-content ul {
                list-style-type: square;
            }

            .policy-content ul > li > ul {
                list-style-type: circle;
            }

            .policy-content ul > li > ul > li > ul {
                list-style-type: square;
            }
        </style>
    </div>
</Layout>
