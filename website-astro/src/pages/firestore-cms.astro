---
// src/pages/firestore-cms.astro
// Dedicated landing page for the "Firestore CMS" keyword cluster.
// Deliberately scoped to the Firestore *data model* so it does not duplicate
// /firebase-cms, which covers the broader Firebase stack.
import Layout from "../layouts/Layout.astro";
import SectionBackgroundAccents from "../components/SectionBackgroundAccents.astro";

const title = "Firestore CMS — Manage Your Firestore Data Visually | FireCMS";
const description = "A Firestore CMS that generates itself from your existing collections. Subcollections, references, arrays and maps become real editing forms — with filters, import/export and role-based access.";
const keywords = "Firestore CMS, CMS for Firestore, Firestore admin panel, Firestore GUI, Firestore UI, Firestore database GUI, Firestore content management, Firestore admin, Firebase CMS";

const breadcrumbs = [
    { name: "Home", url: "https://firecms.co" },
    { name: "Firestore CMS", url: "https://firecms.co/firestore-cms" }
];

const faqItems = [
    {
        question: "What is a Firestore CMS?",
        answer: "A Firestore CMS is an editing interface built directly on Cloud Firestore. Instead of copying content into a separate database, it maps your existing collections and documents to typed forms, so your app keeps querying the same Firestore data while your team edits it through a proper UI."
    },
    {
        question: "Do I have to restructure my Firestore data?",
        answer: "No. FireCMS imposes no data structure restrictions. It reads the documents already in a collection, infers the field types, and generates the views from that. Collections that were designed long before you adopted a CMS still work."
    },
    {
        question: "Does it handle subcollections?",
        answer: "Yes. Subcollections are first-class: you can open a document and edit its subcollections inline, nested as deeply as your model goes."
    },
    {
        question: "How are Firestore references handled?",
        answer: "Reference fields render as searchable pickers over the target collection, so editors choose a related document instead of pasting a document path. Arrays of references work the same way."
    },
    {
        question: "Can I filter, sort and search my Firestore collections?",
        answer: "Yes — filtering and sorting map onto Firestore queries, and full-text search can be plugged in through an external index when Firestore's native querying is not enough."
    },
    {
        question: "Can I import and export Firestore data?",
        answer: "Yes. FireCMS supports importing data into a collection and exporting it back out, which covers bulk edits and migrations without one-off scripts."
    },
    {
        question: "Is the data still mine?",
        answer: "Entirely. The content never leaves your Firestore instance — FireCMS reads and writes it in place under your own security rules, so there is nothing to migrate if you stop using it."
    }
];
---

<Layout
        title={title}
        description={description}
        keywords={keywords}
        breadcrumbs={breadcrumbs}
        faqItems={faqItems}
        localized={false}
>
    <main>
        <!-- Hero -->
        <section class="relative isolate overflow-hidden bg-linear-to-br from-black to-surface-950 pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pt-40 lg:pb-24">
            <SectionBackgroundAccents topLine={true} blob={{ position: "top", size: "lg", opacity: 60 }}/>
            <div class="pointer-events-none absolute inset-0 -z-10">
                <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:40px_40px] opacity-10"></div>
            </div>

            <div class="px-4 mx-auto max-w-7xl text-center lg:px-12">
                <div class="inline-flex items-center py-1.5 px-3 mb-6 sm:mb-7 text-sm rounded-full bg-surface-800/40 text-surface-400 ring-1 ring-inset ring-white/10 mx-auto" role="status">
                    <span class="text-sm font-medium">No migration · No data structure restrictions</span>
                </div>
                <h1 class="mb-8 text-5xl font-extrabold tracking-tight leading-none md:text-6xl text-white font-sans">
                    A <span class="text-orange-500 subtle-shimmer">Firestore</span> CMS<br/> that builds itself
                </h1>
                <p class="mb-10 text-lg leading-8 text-surface-300 lg:text-xl sm:px-16 xl:px-48">
                    Point FireCMS at a Cloud Firestore collection and it infers the schema from the documents
                    already there — then generates the tables, forms and validation your team needs to edit them.
                </p>
                <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
                    <a href="https://app.firecms.co"
                       data-track
                       id="firestore-cms-start"
                       class="inline-flex items-center gap-x-2 rounded-md bg-primary px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-dark transition-all duration-200 ease-in-out btn-glow">
                        Connect Your Firestore
                    </a>
                    <a href="/docs" class="inline-flex items-center gap-x-2 rounded-md border border-surface-700 bg-surface-900/50 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-surface-800 transition-all duration-200 ease-in-out">
                        Read the Docs
                    </a>
                </div>
            </div>
        </section>

        <!-- Definition -->
        <section class="bg-black py-16 sm:py-24">
            <div class="mx-auto max-w-3xl px-6 lg:px-8">
                <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-6">What is a Firestore CMS?</h2>
                <p class="text-lg leading-8 text-surface-300 mb-5">
                    A <strong class="text-white">Firestore CMS</strong> is a content management layer that edits
                    Cloud Firestore documents in place. Your collections stay where they are; the CMS supplies the
                    thing Firestore deliberately leaves out — a structured, permissioned, human-friendly way to
                    change the data.
                </p>
                <p class="text-lg leading-8 text-surface-400">
                    The hard part is not rendering a table. It is mapping Firestore's document model — nested maps,
                    arrays, references, subcollections, timestamps, geopoints — onto controls a non-developer can
                    use without corrupting anything.
                </p>
            </div>
        </section>

        <!-- Data model mapping -->
        <section class="bg-black py-16 sm:py-24">
            <div class="mx-auto max-w-5xl px-6 lg:px-8">
                <div class="mx-auto max-w-2xl text-center mb-14">
                    <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">Your Firestore model, mapped</h2>
                    <p class="mt-4 text-lg leading-8 text-surface-400">Every Firestore type gets a control that makes sense for it.</p>
                </div>
                <div class="overflow-x-auto rounded-2xl ring-1 ring-inset ring-surface-800">
                    <table class="w-full text-left text-surface-300">
                        <thead class="bg-surface-900/70 text-white">
                            <tr>
                                <th scope="col" class="px-6 py-4 font-semibold">Firestore</th>
                                <th scope="col" class="px-6 py-4 font-semibold">In the CMS</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-surface-800">
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white">Collection</th><td class="px-6 py-4">A table view with filtering, sorting and inline editing</td></tr>
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white">Subcollection</th><td class="px-6 py-4">Nested, editable from inside the parent document</td></tr>
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white"><code>DocumentReference</code></th><td class="px-6 py-4">A searchable picker over the referenced collection</td></tr>
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white">Map</th><td class="px-6 py-4">A grouped set of typed subfields</td></tr>
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white">Array</th><td class="px-6 py-4">Reorderable repeatable entries of any field type</td></tr>
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white"><code>Timestamp</code></th><td class="px-6 py-4">Date and time pickers</td></tr>
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white">String (long)</th><td class="px-6 py-4">Markdown or a Notion-style rich text editor</td></tr>
                            <tr><th scope="row" class="px-6 py-4 font-medium text-white">Storage path</th><td class="px-6 py-4">An upload field writing to Firebase Storage</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Beyond editing -->
        <section class="bg-black py-16 sm:py-24">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
                <div class="mx-auto max-w-2xl text-center mb-14">
                    <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl">More than a data browser</h2>
                </div>
                <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
                    <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-2">Schema inference</h3>
                        <p class="text-surface-400">Existing documents are sampled to guess field types, so a legacy collection is usable immediately — then refined in the visual editor or in TypeScript.</p>
                    </div>
                    <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-2">Validation</h3>
                        <p class="text-surface-400">Required fields, min/max, regex — enforced in the form before anything reaches Firestore.</p>
                    </div>
                    <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-2">Real-time</h3>
                        <p class="text-surface-400">Firestore listeners keep the views live, so two editors working the same collection see each other's changes.</p>
                    </div>
                    <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-2">Import and export</h3>
                        <p class="text-surface-400">Bulk-load a collection or pull it back out, instead of writing another one-off migration script.</p>
                    </div>
                    <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-2">Permissions</h3>
                        <p class="text-surface-400">Roles and per-collection create/edit/delete rules on top of Firebase Auth, resolvable per user or per document.</p>
                    </div>
                    <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                        <h3 class="text-xl font-semibold text-white mb-2">Text search</h3>
                        <p class="text-surface-400">Firestore has no native full-text search — plug in an external index and search from the same table view.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="bg-black py-16 sm:py-24">
            <div class="mx-auto max-w-3xl px-6 lg:px-8">
                <h2 class="text-3xl font-medium tracking-tight text-white sm:text-4xl mb-12 text-center">Firestore CMS FAQ</h2>
                <dl class="space-y-8">
                    {faqItems.map(item => (
                        <div class="rounded-2xl bg-surface-900/50 p-7 ring-1 ring-inset ring-surface-800">
                            <dt class="text-xl font-semibold text-white mb-3">{item.question}</dt>
                            <dd class="text-surface-400 leading-7">{item.answer}</dd>
                        </div>
                    ))}
                </dl>
            </div>
        </section>

        <!-- Related -->
        <section class="bg-black pb-24">
            <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
                <h2 class="text-2xl font-medium tracking-tight text-white mb-6">Keep reading</h2>
                <ul class="flex flex-wrap justify-center gap-x-6 gap-y-3 text-surface-300">
                    <li><a href="/firebase-cms" class="text-primary hover:underline">Firebase CMS</a></li>
                    <li><a href="/compare/firecms-vs-firebase-console" class="text-primary hover:underline">vs Firebase Console</a></li>
                    <li><a href="/compare/firecms-vs-supabase" class="text-primary hover:underline">vs Supabase</a></li>
                    <li><a href="/developers" class="text-primary hover:underline">For developers</a></li>
                    <li><a href="/features" class="text-primary hover:underline">All features</a></li>
                </ul>
            </div>
        </section>
    </main>
</Layout>
