{
  "hosting": {
    "public": "dist",
    "site": "firecms-landing-2",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/f/backend_extension",
        "destination": "/features",
        "type": 301
      },
      {
        "source": "/openai",
        "destination": "/features",
        "type": 301
      },
      {
        "source": "/docs/self/mongodb{,/}",
        "destination": "/docs/self/",
        "type": 301
      },
      {
        "source": "/de/docs/self/mongodb{,/}",
        "destination": "/de/docs/self/",
        "type": 301
      },
      {
        "source": "/es/docs/self/mongodb{,/}",
        "destination": "/es/docs/self/",
        "type": 301
      },
      {
        "source": "/fr/docs/self/mongodb{,/}",
        "destination": "/fr/docs/self/",
        "type": 301
      },
      {
        "source": "/it/docs/self/mongodb{,/}",
        "destination": "/it/docs/self/",
        "type": 301
      },
      {
        "source": "/pt/docs/self/mongodb{,/}",
        "destination": "/pt/docs/self/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/llms.txt",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(md)",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico|woff|woff2|ttf|otf|eot|mp4|webm|avif)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(json|xml|txt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
